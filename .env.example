# UFPD Quartermaster — environment variable reference.
# Copy to `.env.dev` (development) or provide via the host's secret store in
# production. NEVER commit a real `.env` / `.env.dev` (only this example file).

# --- Database (Supabase Postgres via PostgREST) ---
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
# Shared secret sent as the `x-app-secret` header on every PostgREST call
# (RLS hardening). Must match the value the database policies expect.
APP_DB_SECRET=change-me

# --- Server ---
PORT=5000
NODE_ENV=development

# --- Authentication ---
# local | sso  (production sits behind Apache + Shibboleth with AUTH_MODE=sso)
AUTH_MODE=local
SSO_HEADER_UID=REMOTE_USER

# --- Email ---
# log | resend | smtp  (log = record only, never delivered)
EMAIL_PROVIDER=log
EMAIL_FROM=quartermaster@example.org
# Resend provider
RESEND_API_KEY=
# SMTP provider
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# --- Reports: weekly low-stock trigger (#15) ---
# Bearer secret required by POST /api/reports/low-stock/run. The external
# scheduler must send `Authorization: Bearer <REPORT_TRIGGER_SECRET>`.
# Compared in constant time; a missing/incorrect value returns 401.
REPORT_TRIGGER_SECRET=devtriggersecret123
